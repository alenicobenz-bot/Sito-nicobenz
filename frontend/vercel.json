{
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "devCommand": "yarn start",
  "installCommand": "yarn install",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^nicobenz\\.it$" }],
      "destination": "https://www.nicobenz.it/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^nicobenz\\.it$" }],
      "destination": "https://www.nicobenz.it/:path*",
      "permanent": true
    },
    { "source": "/post/", "destination": "/blog", "permanent": true },
    { "source": "/single-post/", "destination": "/blog", "permanent": true },
    { "source": "/blog-1/", "destination": "/blog", "permanent": true },
    { "source": "/category/", "destination": "/blog", "permanent": true },
    { "source": "/categories/", "destination": "/blog", "permanent": true },
    { "source": "/tag/", "destination": "/blog", "permanent": true },
    { "source": "/tags/", "destination": "/blog", "permanent": true },
    { "source": "/forum/", "destination": "/", "permanent": true },
    { "source": "/group/", "destination": "/", "permanent": true },
    { "source": "/groups/", "destination": "/", "permanent": true },
    { "source": "/members/", "destination": "/", "permanent": true },
    { "source": "/profile/", "destination": "/", "permanent": true },
    { "source": "/author/", "destination": "/", "permanent": true },
    { "source": "/wix/", "destination": "/", "permanent": true },
    { "source": "/_functions/", "destination": "/", "permanent": true },
    { "source": "/_partials/", "destination": "/", "permanent": true },
    { "source": "/1-video-al-giorno/", "destination": "/un-video-al-giorno", "permanent": true },
    { "source": "/forum/:path*", "destination": "/", "permanent": true },
    { "source": "/group/:path*", "destination": "/", "permanent": true },
    { "source": "/groups/:path*", "destination": "/", "permanent": true },
    { "source": "/members/:path*", "destination": "/", "permanent": true },
    { "source": "/profile/:path*", "destination": "/", "permanent": true },
    { "source": "/post/:path*", "destination": "/blog", "permanent": true },
    { "source": "/single-post/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog-1/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog-feed.xml", "destination": "/blog", "permanent": true },
    { "source": "/category/:path*", "destination": "/blog", "permanent": true },
    { "source": "/categories/:path*", "destination": "/blog", "permanent": true },
    { "source": "/tag/:path*", "destination": "/blog", "permanent": true },
    { "source": "/tags/:path*", "destination": "/blog", "permanent": true },
    { "source": "/author/:path*", "destination": "/", "permanent": true },
    { "source": "/wix/:path*", "destination": "/", "permanent": true },
    { "source": "/_functions/:path*", "destination": "/", "permanent": true },
    { "source": "/_partials/:path*", "destination": "/", "permanent": true },
    { "source": "/1-video-al-giorno", "destination": "/un-video-al-giorno", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
